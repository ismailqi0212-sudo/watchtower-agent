# -----------------------------------------------------------------------------
# Watchtower configuration
# Copy to .env. Every value is optional: the app runs fully offline in demo mode.
# -----------------------------------------------------------------------------

# Watchlist used on a fresh database / GitHub Actions
STOCK_LIST=600519,300750,000001,601318,002594,600036
# Add US tickers when DATA_PROVIDER=auto or nasdaq, e.g. AAPL,NVDA

# Market data: demo | akshare | nasdaq | auto (A-share + US)
DATA_PROVIDER=demo

# News: auto uses Tavily when a key is present, otherwise the provider's native news
NEWS_PROVIDER=auto
TAVILY_API_KEY=

# LLM mode: any OpenAI-compatible endpoint works (OpenAI, DeepSeek, Qwen, Ollama...).
# Leave empty to use the deterministic demo policy.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# Agent budget
AGENT_MAX_STEPS=8
AGENT_TIMEOUT_SECONDS=90

# Storage and fixtures
WATCHTOWER_DB=data/watchtower.db
WATCHTOWER_DEMO_DIR=data/demo
SEED_DEMO=true

# Comma-separated origins for the Vite dev server
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
